<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExerciseMuscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHEST &amp; TRICEPS"
                android:textAllCaps="true"
                android:textColor="@color/electric_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Push-Ups"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbExerciseCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/electric_red"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvExerciseSetsReps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_unselected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="3 Sets × 12 reps"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExerciseRest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_unselected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Rest: 60s"
            android:textColor="@color/grey_text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvExerciseDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="Keep your body in a straight plank line, lower chest toward the floor, and push back up."
        android:textColor="@color/grey_text"
        android:textSize="13sp" />

</LinearLayout>