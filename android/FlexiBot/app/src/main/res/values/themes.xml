<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.FlexiBot" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Customize your dark theme here -->
        <item name="colorPrimary">@color/electric_red</item>
        <item name="colorPrimaryVariant">@color/dark_red</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- UI Backgrounds -->
        <item name="android:windowBackground">@color/black_primary</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/grey_text</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/black_primary</item>
    </style>

    <style name="Theme.FlexiBot" parent="Base.Theme.FlexiBot" />
</resources>